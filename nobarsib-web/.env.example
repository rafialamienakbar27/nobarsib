# Salin jadi .env.local untuk pengembangan:  cp .env.example .env.local

# Dipakai server Next saat merender halaman.
# Di dalam Docker, ganti jadi http://api:8080/v1 (nama service, bukan localhost).
API_URL=http://localhost:8080/v1

# Dipakai browser pengguna. Harus alamat yang terlihat dari luar container.
NEXT_PUBLIC_API_URL=http://localhost:8080/v1

# Nomor WhatsApp untuk pendaftaran venue di halaman /untuk-venue.
# Kosongkan kalau belum ada; halaman akan menampilkan pesan alternatif.
NEXT_PUBLIC_ADMIN_WA=

# Alamat publik situs. Hanya perlu diisi di produksi.
#
# Harus PERSIS sama dengan `host` di nobarsib-android/twa-manifest.json —
# alamat itu ikut ditandatangani ke dalam APK, dan beda satu huruf pun (atau
# "www" yang tertinggal) membuat aplikasi Android terbuka dengan bilah alamat
# peramban di atasnya. Mengubah ini wajib diikuti `make apk`.
NEXT_PUBLIC_SITE_URL=https://nobarsib.vercel.app
