nobarsib-android/signing.env

# Berkas lingkungan berisi kredensial.
**/.env
**/.env.local
**/.env.*.local

# Bukan bagian dari situs.
nobarsib-api/
nobarsib-android/
*.md

# Keluaran build dan dependensi.
**/node_modules
**/.next
**/bin
