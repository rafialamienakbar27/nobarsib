# Salin jadi .env untuk development lokal:  cp .env.example .env
#
# Nilai di bawah HANYA untuk development. Config loader menolak start di
# production kalau rahasia masih mengandung kata "dev", "ganti", "secret", dst.
# (checklist rilis §23: "environment variable produksi tidak ada nilai default
# development").

APP_ENV=development
PORT=8080

# Port 5434, bukan 5432/5433 — lihat catatan di docker-compose.yml.
# Postgres lain (Homebrew, Postgres.app) sering sudah memegang port itu dan
# koneksi akan nyasar ke sana tanpa pesan error yang jelas.
DATABASE_URL=postgres://nobarsib:devpassword@localhost:5434/nobarsib?sslmode=disable
DATABASE_MAX_CONN=10

REDIS_URL=redis://localhost:6379/0

# Di production, hasilkan dengan:  openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-minimal-32-karakter
DEVICE_HASH_SALT=dev-only-device-salt-minimal-32-karakter

SHUTDOWN_TIMEOUT_SEC=15

# Origin yang boleh memanggil API dari browser, dipisah koma.
#
# Wajib saat pengembangan: web di :3000 dan API di :8080 adalah dua origin
# berbeda, jadi tanpa ini browser memblokir setiap permintaan dari halaman dan
# tab urutan, chip filter, serta tombol lokasi berhenti bekerja tanpa pesan.
#
# Di produksi, kalau web dan API berbagi domain lewat reverse proxy, ini boleh
# dikosongkan. Nilai "*" ditolak — API ini juga melayani /v1/auth dan /v1/admin.
CORS_ORIGINS=http://localhost:3000
